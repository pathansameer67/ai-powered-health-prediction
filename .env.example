# Environment Configuration for AI Healthcare Information Assistant
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Groq LLM API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
FALLBACK_GROQ_MODEL=llama-3.1-8b-instant

# Embedding Model (HuggingFace / local)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage & Vector Database Paths
DATABASE_URL=sqlite+aiosqlite:///./data/healthcare_assistant.db
CHROMA_PERSIST_DIR=./data/chroma_db
UPLOAD_DIR=./data/uploads
TRUSTED_DOCS_DIR=./data/trusted_docs

# Safety & System Defaults
DEFAULT_JURISDICTION=IN
PAN_INDIA_EMERGENCY_NUMBER=112
US_EMERGENCY_NUMBER=911
UK_EMERGENCY_NUMBER=999

# Document Ingestion & Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MAX_UPLOAD_SIZE_MB=25

# Security
SECRET_KEY=change_this_to_a_secure_random_key_in_production_32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
